<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.allcli</groupId>
        <artifactId>allcli-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>allcli-gateway</artifactId>
    <name>AllCLI Gateway</name>
    <description>L4 工具网关：invoke 流水线（鉴权/意图/限流/分级-HITL/转发/审计）+ 凭证信封加密</description>

    <dependencies>
        <!-- Web (MVC, 同步阻塞栈；invoke 是编排流水线非反向代理，不用响应式 SCG) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MCP Server（D12：与网关同进程；tools/list + tools/call，streamable HTTP 端点 /mcp） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- JPA：读 ToolDefinition/System/Credential/Subscription，写 Invocation/Approval -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Redis：限流计数 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON Schema 校验：复用 MCP SDK 的 DefaultJsonSchemaValidator（mcp-json-jackson2，经 starter 传递），
             不再直依赖 networknt（1.x 与 SDK 所需 2.x 的 Dialects 类冲突，2.x 又是彻底重写无旧 API） -->

        <!-- 转化引擎（M4 导入 REST 化）：仅用纯 Java 类 OpenApiLoader/ToolMapper，
             engine 的 Spring bean/实体不在本模块扫描范围（com.allcli.gateway 为根） -->
        <dependency>
            <groupId>com.allcli</groupId>
            <artifactId>allcli-engine</artifactId>
        </dependency>

        <!-- 国密 SM4 软实现（凭证信封加密，一期 Vault 软实现） -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- Actuator + Prometheus（FR-OPS-01 一期：QPS/延迟/JVM 基础指标，/actuator/prometheus）。
             micrometer 1.15 的 micrometer-registry-prometheus 已内置新客户端类（io.micrometer.prometheusmetrics），
             满足 Boot 3.5 自动配置条件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
